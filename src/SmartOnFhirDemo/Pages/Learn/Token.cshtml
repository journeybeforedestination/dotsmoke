@page "/learn/token"
@model SmartOnFhirDemo.Pages.Learn.TokenModel
@{
    ViewData["Title"] = "The token, and the session it opens";
}

<partial name="_Progress" model="Model.Steps.Select(step => step.Number).ToArray()" />

@foreach (var step in Model.Steps)
{
    <partial name="_Step" model="step" />
}

<p class="next">
    <a class="button" asp-page="/Learn/User"
       asp-route-id="@Model.LaunchId" asp-route-patient="@Model.PatientId">Who launched it &rarr;</a>
</p>
