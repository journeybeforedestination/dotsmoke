@*
    Every tab is a real link to a real URL, and pressing one works with no script at all;
    wwwroot/app.js only spares the reader the reload. Nothing here knows that happened,
    which is the point — a swap and a navigation produce markup from one partial.
*@
@model AppView

<article class="app">
    <header class="banner">
        <h2>@Model.Summary.Banner</h2>
        @if (Model.Summary.Meta.Any())
        {
            <p class="meta">@string.Join(" · ", Model.Summary.Meta)</p>
        }
    </header>

    <div class="demographics">
        <dl class="facts">
            @foreach (var (label, value) in Model.Summary.Details)
            {
                <dt>@label</dt>
                <dd>@value</dd>
            }
        </dl>
    </div>

    <nav class="tabs" aria-label="This patient's chart">
        @foreach (var panel in ChartPanel.All)
        {
            var open = Model.Chart.Shown?.Panel.Slug == panel.Slug;

            <a href="@Model.Chart.Link(panel)" aria-current="@(open ? "page" : null)">@panel.Title</a>
        }
    </nav>

    <div class="pane">
        <partial name="_Pane" model="Model.Chart" />
    </div>

    @*
        Below the chart and above the raw resource: what the app did is a first-class idea
        here, and the JSON is an appendix.
    *@
    <section class="access">
        <h3>The EHR wrote all of this down</h3>

        <p>
            A real EHR audits every read, and so does this one: each request above left a row
            naming the launch that caused it, not what came back. Below is this launch's own
            trail — FHIR requests only, so discovery, the token exchange and the JWKS fetch
            that steps ① to ⑤ narrated are not in it. Nor is opening this list: reading the
            log touches no EHR.
        </p>

        <details>
            <summary>What this launch asked the EHR for</summary>
            <div class="log">
                <partial name="_Access" model="Model.Access" />
            </div>
        </details>
    </section>

    <details>
        <summary>Raw Patient resource</summary>
        <pre>@Model.RawJson</pre>
    </details>
</article>
