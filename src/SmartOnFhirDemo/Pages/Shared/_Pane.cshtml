@*
    Whichever panel is open, split out of _App so `?handler=pane` can render just this much.
    The div's contents rather than the div itself: the wrapper is what the script holds on
    to, and a partial that re-rendered it would replace the element the swap was aimed at.
*@
@model ChartView

@if (Model.Shown is { } shown)
{
    @* No heading: the pressed tab directly above is the panel's name. The label is on the
       section for anyone not reading it by eye. *@
    <section aria-label="@shown.Panel.Title">
        @if (shown is ChartOutcome.Read read)
        {
            <ul class="entries">
                @foreach (var entry in read.Entries)
                {
                    <li>@entry</li>
                }
            </ul>
        }
        else
        {
            @* A sentence, never an empty list: "none recorded" and "the EHR would
               not say" look identical as nothing, and mean opposite things. *@
            <p class="note">@LaunchMessages.For(shown)</p>
        }
    </section>
}
else
{
    <p class="note">Pick a panel to read on from this patient's chart.</p>
}
