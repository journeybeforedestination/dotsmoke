<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SMART on FHIR demo</title>
    <style>
        :root { color-scheme: light dark; }
        body {
            font: 16px/1.5 system-ui, sans-serif;
            max-width: 42rem;
            margin: 3rem auto;
            padding: 0 1.5rem;
        }
        h1 { font-size: 1.5rem; margin-bottom: 1.5rem; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1.5rem; }
        dt { font-weight: 600; opacity: .7; }
        dd { margin: 0; }
        code, pre { font-family: ui-monospace, monospace; font-size: .875rem; }
        pre {
            overflow-x: auto;
            padding: 1rem;
            border-radius: .375rem;
            background: color-mix(in srgb, currentColor 8%, transparent);
        }
        details { margin-top: 2rem; }
        summary { cursor: pointer; opacity: .7; }

        /* The stops, and which one you are on. A row rather than a sentence, because
           "how much is left" is a question you answer by looking. The columns are
           generated rather than counted, so adding a step does not need a number here. */
        .progress {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: 1fr;
            list-style: none;
            margin: 0 0 3rem;
            padding: 0;
            font-size: .6875rem;
            text-align: center;
        }
        .progress li { position: relative; opacity: .45; }
        .progress .done, .progress .current { opacity: 1; }

        /* The rail, drawn as each chip's leading half so it never overshoots the row. */
        .progress li::before {
            content: "";
            position: absolute;
            top: .25rem;
            right: 50%;
            width: 100%;
            border-top: 1px solid currentColor;
            opacity: .35;
        }
        .progress li:first-child::before { content: none; }

        .progress .dot {
            position: relative;   /* over the rail, not under it */
            display: block;
            width: .5rem;
            height: .5rem;
            margin: 0 auto .5rem;
            border: 1px solid currentColor;
            border-radius: 50%;
            background: Canvas;   /* hides the rail behind an unfilled dot */
        }
        .progress .done .dot { background: currentColor; }
        .progress .current .dot {
            background: currentColor;
            box-shadow: 0 0 0 .1875rem color-mix(in srgb, currentColor 25%, transparent);
        }

        .progress .n { display: block; font-variant-numeric: tabular-nums; opacity: .6; }
        .progress .label { display: block; overflow-wrap: anywhere; }
        .progress .current .label { font-weight: 600; }

        /* The narrated launch: a run of steps, each a heading, a paragraph, and a
           label/value table where every value gets a sentence explaining itself. */
        .lead { margin-bottom: 2.5rem; }
        .step { margin: 2.5rem 0; }
        .step h2 { font-size: 1.0625rem; margin: 0 0 .5rem; }
        .step > p { margin: 0 0 1.25rem; }
        .step dl { gap: 1rem 1.5rem; align-items: baseline; }
        .step dt {
            font-family: ui-monospace, monospace;
            font-size: .8125rem;
            font-weight: 400;
        }
        .step dd code { overflow-wrap: anywhere; }
        .step pre { white-space: pre-wrap; overflow-wrap: anywhere; }
        .note { margin: .375rem 0 0; font-size: .875rem; opacity: .7; }

        .next { margin-top: 2.5rem; }
        .button, .next button {
            display: inline-block;
            font: inherit;
            font-weight: 600;
            padding: .625rem 1.125rem;
            border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
            border-radius: .375rem;
            background: none;
            color: inherit;
            text-decoration: none;
            cursor: pointer;
        }
        .aside { margin-top: 1.5rem; font-size: .875rem; opacity: .65; }
        footer {
            margin-top: 3rem;
            padding-top: 1rem;
            border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
            font-size: .8125rem;
            opacity: .6;
        }
    </style>
</head>
<body>
    <main>
        <h1>@ViewData["Title"]</h1>
        @RenderBody()
    </main>
    <footer>SMART on FHIR demo · Firely SDK · FHIR @ModelInfo.Version</footer>
</body>
</html>
