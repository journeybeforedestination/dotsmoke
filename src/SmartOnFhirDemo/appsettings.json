{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Left wide deliberately, and this is the reason rather than an oversight. Nothing here
  // reads the Host header — every URL this app hands out is built from Smart:PublicOrigin —
  // so host filtering would add no check. It would subtract one: kamal-proxy health-checks
  // the container by address, so a filter naming the public host answers 400 to /up, and
  // that reads as a deploy hanging rather than as a setting.
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AccessLog": "Data Source=app.db"
  },
  "Smart": {
    "PublicOrigin": "http://localhost:5000",
    "ClientId": "smart-on-fhir-demo",
    "Scopes": "launch openid fhirUser patient/Patient.read user/Practitioner.read patient/Condition.read patient/Observation.read patient/MedicationRequest.read",
    "TrustedIssuers": [ "https://launch.smarthealthit.org" ]
  }
}
